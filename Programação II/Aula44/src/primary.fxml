<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="283.0" prefWidth="443.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lucas.aula43.PrimaryController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
   </padding>
   <children>
      <Label text="Teste Aula 44" textAlignment="CENTER">
         <font>
            <Font name="System Bold" size="17.0" />
         </font>
      </Label>
      <HBox maxWidth="-Infinity" prefHeight="100.0" prefWidth="277.0">
         <children>
            <VBox maxWidth="-Infinity" prefHeight="50.0" prefWidth="120.0">
               <children>
                  <Label fx:id="lblValor1" alignment="CENTER" text="Valor 1" textAlignment="CENTER" />
                  <TextField fx:id="txdfldValor1" prefHeight="26.0" prefWidth="50.0" />
               </children>
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </VBox>
            <VBox maxWidth="-Infinity" prefHeight="100.0" prefWidth="139.0">
               <children>
                  <Label fx:id="lblValor2" text="Valor 2" />
                  <TextField fx:id="txtfldValor2" prefHeight="26.0" prefWidth="110.0" />
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Button fx:id="bttnSomar" mnemonicParsing="false" onAction="#somar" prefWidth="75.0" text="Somar">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="bttnSubtrair" mnemonicParsing="false" onAction="#subtrair" prefWidth="75.0" text="Subtrair">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="bttnMult" mnemonicParsing="false" onAction="#multiplicar" prefWidth="75.0" text="Multiplicar">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="bttnDiv" mnemonicParsing="false" onAction="#dividir" prefWidth="75.0" text="Dividir">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Button>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
      <Label fx:id="lblResultado" alignment="CENTER" prefHeight="26.0" prefWidth="280.0" text="Resultado" textFill="#e40000">
         <font>
            <Font size="20.0" />
         </font></Label>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Button fx:id="bttnLimpar" alignment="CENTER" mnemonicParsing="false" onAction="#limpar" prefWidth="75.0" text="Limpar">
               <HBox.margin>
                  <Insets right="30.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="bttnSair" alignment="CENTER" mnemonicParsing="false" onAction="#sair" prefWidth="75.0" text="Sair" />
         </children>
      </HBox>
   </children>
</VBox>
